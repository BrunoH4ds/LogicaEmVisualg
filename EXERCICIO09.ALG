Var
// Seção de Declarações das variáveis
altura:real
area:real

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc...
escreval("Calcular a area de um quadrado")
escreval("Qual a altura do quadrado?")
leia(altura)
area <- (altura*altura/2)
escreval("Em metros ", metros, " são: ", centimetros, "cm")

Fimalgoritmo
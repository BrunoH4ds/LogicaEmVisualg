Algoritmo "Exercicio 06"
// Disciplina   : [Linguagem e Lógica de Programação]
// Professor   : Antonio Carlos Nicolodi 
// Descrição   : Aqui você descreve o que o programa faz! (função)
// Autor(a)    : Bruno Henrique
// Data atual  : 28/08/2026
Var
// Seção de Declarações das variáveis 
base:real
largura:real
multiplicacao:real

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc...
escreval("Calculo de area de um retangulo")
escreval("Qual o valor da base?")
leia(base)
escreval("Qual o valor da largura?")
leia(largura)
multiplicacao<- base * largura

escreval("A area do retangulo é de: ",multiplicacao)

Fimalgoritmo